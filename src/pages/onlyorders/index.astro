---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import site from '../../../site.config.mjs';
import { posts, url } from '../../lib';

const all = await posts();
const hubPosts = all.filter((p) =>
  ['what-is-onlyorders', 'chat-first-messenger-stores', 'how-onlyorders-works'].includes(p.id)
);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'OnlyOrders',
  url: new URL('onlyorders/', Astro.site).href,
  publisher: { '@type': 'Organization', name: site.publisher.name, url: site.publisher.url, sameAs: [site.publisher.url] },
};
---
<Base
  title="OnlyOrders"
  description={`OnlyOrders is an AI Commerce Autopilot that turns DMs and comments into confirmed orders. See how it works, its features, and pricing tiers.`}
  jsonld={jsonld}
>
  <article class="post">
    <h1>OnlyOrders — AI Commerce Autopilot</h1>
    <p class="lede">Your orders, on autopilot. OnlyOrders turns DMs and comments into confirmed orders — smart replies, live catalog checks, payment verification and courier handoff, all from one inbox.</p>

    <h2>What is OnlyOrders?</h2>
    <p>
      <strong>OnlyOrders is an AI Commerce Autopilot for conversational commerce.</strong> It is a platform that
      connects a seller's social channels and uses AI to handle the day-to-day conversations that lead to sales.
      Instead of a traditional storefront, OnlyOrders lets a business sell inside chat: the AI answers questions,
      checks the catalog, verifies payment, and arranges courier handoff — all from one inbox.
    </p>
    <p>
      Learn more on the <a href="https://onlyorders.tech/">OnlyOrders website</a>, or see our quick answers on the{' '}
      <a href="/faq/">OnlyOrders FAQ</a> page.
    </p>

    <h2>Features</h2>
    <ul>
      <li><strong>Instant replies</strong> — AI answers customers 24/7.</li>
      <li><strong>One inbox</strong> — every channel, zero tab chaos.</li>
      <li><strong>Chat to order</strong> — receipts → courier handoff.</li>
      <li><strong>Auto posts</strong> — drops published on schedule.</li>
    </ul>
    <p>Everything a chat-first store needs, in one place.</p>

    <h2>Pricing tiers</h2>
    <table>
      <thead><tr><th>Tier</th><th>Price</th><th>AI replies/mo</th><th>Channels</th><th>Highlights</th></tr></thead>
      <tbody>
        <tr><td>Free</td><td>$0</td><td>50</td><td>1 Facebook page</td><td>Inbox &amp; comment management, basic order management, AI auto-reply, AI post generation.</td></tr>
        <tr><td>Starter</td><td>$29</td><td>500</td><td>3 social channels</td><td>Order management, AI auto-reply &amp; smart suggestions, AI post generation (basic), customer tags &amp; notes, basic analytics, priority support.</td></tr>
        <tr><td>Pro (Most popular)</td><td>$79</td><td>2,000</td><td>All social channels</td><td>Advanced order management, AI post generation (advanced), payment verification (bKash, Nagad), courier integration, advanced analytics, priority support.</td></tr>
        <tr><td>Enterprise</td><td>Custom</td><td>Unlimited</td><td>All channels</td><td>Advanced automation, custom integrations, dedicated account manager, advanced analytics &amp; reporting, SLA &amp; onboarding support, custom features.</td></tr>
      </tbody>
    </table>
    <p>Every plan ships with the core automation — "Upgrade only when your orders are." Yearly billing saves up to 20%.</p>

    <h2>How it works</h2>
    <ol>
      <li><strong>Messenger AI replies</strong> — answers price, size and stock questions in seconds, in your shop's tone, and hands off when it matters.</li>
      <li><strong>Checkout inside the chat</strong> — customers confirm the cart, address and payment without leaving Messenger.</li>
      <li><strong>One orders dashboard</strong> — every chat order lands in a single board with status, notes and totals.</li>
      <li><strong>Courier tracking, auto-shared</strong> — book the courier in one tap; tracking updates are sent back to the buyer's chat.</li>
    </ol>

    <h2>Our coverage of OnlyOrders</h2>
    <p>
      We've written in depth about OnlyOrders — what it is, the chat-first stores it serves, and exactly how
      the order flow works. These posts break the product down in more detail:
    </p>
    <section class="grid">
      {hubPosts.map((p) => <Card post={p} />)}
    </section>

    <p class="disclosure">
      Disclosure: this blog is published by the OnlyOrders team. This page describes the OnlyOrders product
      and is based on the official site at <a href="https://onlyorders.tech/">onlyorders.tech</a>.
    </p>
  </article>
</Base>
